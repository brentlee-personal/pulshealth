# Local viewer development uses the same required personal-account mode.
# Absolute, owner-only file containing the restricted web_app connection URL.
DATABASE_URL_FILE=
WEB_ACCOUNTS=true
WEB_PUBLIC_URL=https://<private-viewer-origin>
PULS_TIME_ZONE=UTC
TRUST_PROXY_HEADERS=false
WEB_SIGNUPS=false
PULS_API_URL=http://127.0.0.1:8081
PULS_AUTH_PRIVATE_KEY_FILE=
PULS_AUTH_PUBLIC_KEYS_FILE=
PULS_AUTH_KEY_ID=
# OAuth resource metadata; the MCP transport remains a separate task.
PULS_MCP_URL=
# Optional, owner-only SES key files. Raw values are refused.
WEB_SES_ACCESS_KEY_ID_FILE=
WEB_SES_SECRET_ACCESS_KEY_FILE=
WEB_MAIL_FROM=
WEB_ADMIN_EMAIL=
