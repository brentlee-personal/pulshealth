# Non-secret settings only. Use scripts/bootstrap.sh to create server/.env.
# Build this exact checkout with compose.build.yml; upstream shared-mode images are incompatible.
# Set the viewer's private HTTPS origin before starting. No public tunnel is enabled.
WEB_PUBLIC_URL=
PULS_PUBLIC_URL=
PULS_TIME_ZONE=UTC
TRUST_PROXY_HEADERS=false
WEB_CLIENT_IP_HEADER=x-forwarded-for
WEB_DB_POOL_SIZE=4
WEB_SIGNUPS=false

# Fixed personal accounts. Removing this line still keeps personal accounts required.
WEB_ACCOUNTS=true

# Initial Ed25519 files. Only web mounts the private signing volume.
PULS_AUTH_PRIVATE_KEY_FILE=/auth-keys/key-v1.pem
PULS_AUTH_PUBLIC_KEYS_FILE=/auth-public/key-v1.json
PULS_AUTH_KEY_ID=key-v1
# Future MCP resource metadata; no MCP service is enabled by this stack.
# PULS_MCP_URL=https://<private-viewer-origin>/mcp

# Optional SES delivery. Put owner-only files in the web secret volume.
# Never paste keys into this settings file.
# WEB_SES_ACCESS_KEY_ID_FILE=/run/secrets/web/WEB_SES_ACCESS_KEY_ID
# WEB_SES_SECRET_ACCESS_KEY_FILE=/run/secrets/web/WEB_SES_SECRET_ACCESS_KEY
WEB_SES_REGION=us-east-1
WEB_MAIL_FROM=
WEB_ADMIN_EMAIL=
WEB_APP_STORE_ALERT_TO=

# Explicit classification of pre-existing personal members for deletion policy.
# No default member, shared phone token or cross-user reader is supported.
WEB_PERSONAL_USERS=
# Enable only after the independent deletion ledger is configured and tested.
PULS_DELETION_LEDGER_DIR=
